{
  "manifest_version": 3,
  "name": "Double-Click Close",
  "version": "1.1",
  "description": "Close tabs by double-clicking on the page. Now with settings!",
  "permissions": ["tabs", "storage"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Double-Click Close Settings"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"]
    }
  ],
  "background": {
    "service_worker": "background.js"
  }
}
